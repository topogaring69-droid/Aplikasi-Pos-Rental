# Koneksi Database PostgreSQL (Vercel Postgres / Supabase / Neon)
# Catatan: Jika menggunakan Vercel Postgres, variabel-variabel berikut otomatis diisi oleh Vercel.
POSTGRES_PRISMA_URL="postgres://default:password@ep-example-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-example.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
DATABASE_URL="postgres://default:password@ep-example-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Driver Penyimpanan Berkas: 'local' (hanya untuk dev lokal) atau 'google_drive' (wajib untuk Vercel)
STORAGE_DRIVER="local"

# Konfigurasi Google Drive (diperlukan untuk penyimpanan nota di cloud Vercel)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
