// Prisma Schema untuk POS Rental Motor
// Dikonfigurasi untuk PostgreSQL (Vercel Postgres / Supabase / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// 1. Akun Pengguna & Autentikasi
model User {
  id        String    @id @default(cuid())
  username  String    @unique
  name      String
  password  String
  role      String    @default("admin")
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

// 2. Sesi Login Multi-Perangkat
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  userAgent String?  @default("") @map("user_agent")
  ipAddress String?  @default("") @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// 3. Master Pelanggan (Customers)
model Customer {
  id               String    @id
  name             String
  phone            String?   @default("")
  nik              String?   @default("")
  address          String?   @default("")
  emergencyContact String?   @default("") @map("emergency_contact")
  notes            String?   @default("")
  totalRentals     Int       @default(0) @map("total_rentals")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("customers")
}

// 4. Master Armada Motor (Fleet)
model Fleet {
  id              String    @id
  nopol           String    @unique
  brand           String
  model           String
  color           String?   @default("")
  year            String?   @default("")
  dailyRate       Int       @map("daily_rate")
  status          String    @default("available")
  taxAnnualDate   String?   @map("tax_annual_date")
  taxFiveYearDate String?   @map("tax_five_year_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("fleet")
}

// 5. Transaksi Rental (Transactions)
model Transaction {
  id            String    @id
  nopol         String
  customerId    String?   @map("customer_id")
  customerName  String    @map("customer_name")
  customerPhone String?   @default("") @map("customer_phone")
  startDate     String    @map("start_date")
  endDate       String    @map("end_date")
  durationDays  Int       @default(1) @map("duration_days")
  durationHours Int?      @default(24) @map("duration_hours")
  rentalPrice   Int       @map("rental_price")
  extraCosts    String?   @default("[]") @map("extra_costs")
  discount      Int       @default(0) @map("discount")
  total         Int
  paymentMethod String    @default("Tunai") @map("payment_method")
  amountPaid    Int       @map("amount_paid")
  changeAmount  Int       @default(0) @map("change_amount")
  paymentStatus String    @default("lunas") @map("payment_status")
  status        String    @default("active")
  notes         String?   @default("")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([status])
  @@index([paymentStatus])
  @@map("transactions")
}

// 6. Pengeluaran Operasional & Servis (Expenses)
model Expense {
  id               String    @id
  isVehicleRelated Boolean   @default(false) @map("is_vehicle_related")
  nopol            String?
  category         String    @default("Umum")
  amount           Int
  description      String?   @default("")
  date             String
  receiptPhoto     String?   @map("receipt_photo")
  gdriveFileId     String?   @map("gdrive_file_id")
  gdriveLink       String?   @map("gdrive_link")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("expenses")
}

// 7. Pengaturan Aplikasi POS (Settings)
model Setting {
  key   String @id
  value String

  @@map("settings")
}
